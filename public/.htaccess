<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    # Docker php-apache men-set DirectoryIndex index.php dulu — paksa index.html
    # (frontend Nuxt SSG) didahulukan untuk SPA + API satu origin.
    DirectoryIndex index.html index.php

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # API routes → Laravel (tenancy resolve dari Host header subdomain tenant)
    RewriteCond %{REQUEST_URI} ^/api(/|$)
    RewriteRule ^ index.php [L]

    # Health check → Laravel
    RewriteCond %{REQUEST_URI} ^/up$
    RewriteRule ^ index.php [L]

    # SPA fallback: file asli ada → serve langsung; selainnya → index.html (Nuxt SSG)
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteRule ^ index.html [L]
</IfModule>
